&CONTROL
  calculation = 'scf'
  prefix = 'co2_int'
  outdir = './tmp'
  pseudo_dir = '../pseudopotensial'
  nstep = 200
/

&SYSTEM
  ibrav = 0
  nat = 3
  ntyp = 2
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  vdw_corr = 'DFT-D3'
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

CELL_PARAMETERS angstrom
  6.06427   0.00000   0.00000
 -1.51607   2.62591   0.00000
  0.00000   0.00000  19.42568

ATOMIC_SPECIES
 C  12.011 C.pbe-n-kjpaw_psl.1.0.0.UPF
 O  15.999 O.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS angstrom
! coordinate after r_CO2.in optimized
K_POINTS automatic
 3 6 1 0 0 0
