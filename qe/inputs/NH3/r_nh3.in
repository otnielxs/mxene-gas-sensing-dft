&CONTROL
  calculation = 'relax'
  prefix = 'nh3'
  outdir = './tmp'
  pseudo_dir = '../pseudopotensial'
/

&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 2
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

