&CONTROL
  calculation = 'nscf'
  prefix = 'nh3'
  outdir = './tmp'
  pseudo_dir = '../pseudopotensial'
/

&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 2
  ecutwfc = 40
  ecutrho = 320
  occupations = 'tetrahedra'
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

CELL_PARAMETERS angstrom
  6.06427   0.00000   0.00000
 -1.51607   2.62591   0.00000
  0.00000   0.00000  19.42568

ATOMIC_SPECIES
 N  14.007 N.pbe-n-kjpaw_psl.1.0.0.UPF
 H   1.008 H.pbe-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS angstrom
! coordinate after r_nh3.in optimized
K_POINTS automatic
 4 8 1 0 0 0
