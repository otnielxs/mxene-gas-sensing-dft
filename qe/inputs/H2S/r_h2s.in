&CONTROL
  calculation = 'relax'
  prefix = 'h2s'
  outdir = './tmp'
  pseudo_dir = '../pseudopotensial'
/

&SYSTEM
  ibrav = 0
  nat = 3
  ntyp = 2
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

